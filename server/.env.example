APP_NAME=Scaler Assignment API
API_PREFIX=/api
# SQLite file lives under server/data/ (stable across restarts). For cloud deploys
# with ephemeral disks, use Postgres instead, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:3000

SESSION_COOKIE_NAME=session_token
SESSION_MAX_AGE_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

PASSWORD_MIN_LENGTH=8
