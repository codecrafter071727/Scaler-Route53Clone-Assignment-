APP_NAME=Scaler Assignment API
API_PREFIX=/api
DATABASE_URL=sqlite:///./data/app.db

# Comma-separated frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000,https://route53-gamma.vercel.app

SESSION_COOKIE_NAME=session_token
SESSION_MAX_AGE_SECONDS=604800
PASSWORD_MIN_LENGTH=8

# Local API (http://localhost:8000):
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Render API + browser on another origin (e.g. localhost:3000):
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
